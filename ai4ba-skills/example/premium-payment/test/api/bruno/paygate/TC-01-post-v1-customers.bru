meta {
  name: TC-01 POST /v1/customers
  type: http
  seq: 1
}

post {
  url: {{PAYGATE_BASE}}/v1/customers
  body: json
  auth: bearer
}

auth:bearer {
  token: {{process.env.PAYGATE_KEY}}
}

body:json {
  {
    "email": "learner@example.com"
  }
}

assert {
  res.status: eq 201
  res.body.object: eq customer
}
