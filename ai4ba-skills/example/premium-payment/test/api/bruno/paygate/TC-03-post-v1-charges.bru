meta {
  name: TC-03 POST /v1/charges
  type: http
  seq: 3
}

post {
  url: {{PAYGATE_BASE}}/v1/charges
  body: json
  auth: bearer
}

auth:bearer {
  token: {{process.env.PAYGATE_KEY}}
}

body:json {
  {
    "amount": 99000,
    "currency": "vnd",
    "source": "tok_insufficient"
  }
}

assert {
  res.status: eq 402
  res.body.error.code: eq insufficient_funds
}
