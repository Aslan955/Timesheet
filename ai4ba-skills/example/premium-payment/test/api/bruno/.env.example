# Copy file này -> bruno/.env rồi điền key thật. KHÔNG commit (.env đã gitignored).
# Bruno (extension + CLI) tự nạp file .env này ở collection root vào process.env;
# request .bru tham chiếu {{process.env.PAYGATE_KEY}} / {{process.env.MAILGATE_KEY}}.
# Base URL KHÔNG để ở đây — nằm trong bruno/environments/{mock,sandbox,prod}.bru.

# PayGate (cổng thanh toán). Mock dùng key mặc định sk_test_demo_4242.
PAYGATE_KEY=sk_test_xxxxxxxxxxxxxxxx

# MailGate (email giao dịch) — KHÁC khóa PayGate. Mock dùng mg_test_demo_4343.
MAILGATE_KEY=mg_test_xxxxxxxxxxxxxxxx
